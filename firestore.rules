rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tài khoản giáo viên: tạo trong Firebase Console với email này, mật khẩu conmoe
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@donghoquaynguoc.vn';
    }

    // Ngân hàng câu hỏi, cài đặt, thư viện đề: ai cũng đọc được, chỉ Admin được sửa
    match /bank/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /config/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /library/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /libraryChunks/{doc} { allow read: if true; allow write: if isAdmin(); }

    // Tiến trình học sinh: chính học sinh đó đọc/ghi; Admin được xem
    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Phiếu đổi quà: học sinh đã đăng nhập xem được (để tính số lượng còn lại), chỉ tạo phiếu của chính mình ở trạng thái chờ; Admin duyệt/huỷ
    match /redeems/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'cho'
        && request.resource.data.gia is number && request.resource.data.gia >= 0;
      allow update, delete: if isAdmin();
    }

    // Bảng xếp hạng: ai cũng xem; người đã đăng nhập chỉ thêm kết quả của chính mình
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.khoi in [3, 4, 5]
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.expect in [7, 8, 9, 10]
        && request.resource.data.score >= request.resource.data.expect
        && request.resource.data.rewinds is int
        && request.resource.data.rewinds >= 0
        && request.resource.data.rewinds <= 5
        && request.resource.data.time is int
        && request.resource.data.time > 0;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
